# =====================================================================
# 6a. Trajectoire vers l'accès universel (ODD 7, horizon 2030)
#     Extrapolation linéaire sur 10 ans : un outil de lecture, pas une prévision.
SEUIL_UNIVERSEL <- 95   # seuil arbitraire, à discuter
rythme <- df %>%
filter(annee > AN_FIN - 10, !is.na(acces_rural)) %>%
group_by(iso3c, pays, sous_region) %>%
filter(n() >= 5) %>%
summarise(R_dern  = acces_rural[which.max(annee)],
an_dern = max(annee),
pente   = coef(lm(acces_rural ~ annee))[["annee"]],   # pts de %/an
.groups = "drop") %>%
mutate(
proj_2030 = pmin(100, R_dern + pmax(pente, 0) * (2030 - an_dern)),
annees_pour_universel = if_else(pente > 0, pmax(0, (SEUIL_UNIVERSEL - R_dern) / pente), NA_real_),
statut = case_when(
R_dern >= SEUIL_UNIVERSEL  ~ "Quasi universel",
pente < 0.5                ~ "Stagnation (< 0,5 pt/an)",
proj_2030 >= SEUIL_UNIVERSEL ~ "Sur la trajectoire 2030",
TRUE                       ~ "En retard"
))
